---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Enquiry sent | John Eyitope" description="Your project enquiry has been sent." noindex>
  <section class="grid-bg flex min-h-[70vh] items-center">
    <div class="container-x py-24">
      <p class="label text-lime">Enquiry received</p>
      <h1 class="display display-lg mt-4 max-w-4xl">Thanks. Your message is in.</h1>
      <p class="lead mt-6 max-w-xl text-paper/80">You will get a reply by email soon.</p>
      <a href="/" class="btn btn-ghost mt-10"><Icon name="arrow-left" /> Back to the homepage</a>
    </div>
  </section>
</Base>
