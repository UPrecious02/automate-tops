---
import Logo from './Logo.astro';
import { site, socialLinks } from '../data/site';

const year = new Date().getFullYear();

const pages = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="border-t border-line bg-ink">
  <div class="container-x flex flex-col gap-10 py-12 md:flex-row md:items-end md:justify-between">
    <div class="max-w-sm">
      <Logo size={40} />
      <p class="mt-5 text-sm leading-relaxed text-mute">
        {site.title}. Designing and building automation systems that connect AI, APIs and business software.
      </p>
    </div>

    <div class="flex flex-col gap-6 md:items-end">
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {
            pages.map((page) => (
              <li>
                <a href={page.href} class="text-sm font-medium text-paper/85 transition-colors hover:text-lime">{page.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="flex flex-wrap gap-x-6 gap-y-3">
        <li>
          <a href={`mailto:${site.email}`} class="label text-paper/80 transition-colors hover:text-lime">Email</a>
        </li>
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="label text-paper/80 transition-colors hover:text-lime"
              >
                {link.label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="label text-mute">© {year} {site.name}</p>
    </div>
  </div>
</footer>
