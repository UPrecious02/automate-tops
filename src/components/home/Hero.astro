---
import Icon from '../Icon.astro';
import Portrait from '../Portrait.astro';
import SystemFlow from './SystemFlow.astro';
import { site } from '../../data/site';

const log = [
  { mark: '✓', text: 'webhook.received', tone: 'text-lime' },
  { mark: '✓', text: 'intent.classified', tone: 'text-lime' },
  { mark: '→', text: 'route: new_order', tone: 'text-paper' },
  { mark: '✓', text: 'record.saved', tone: 'text-lime' },
  { mark: '●', text: 'reply.sent', tone: 'text-orange' },
];
---

<section class="grid-bg relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
  <div class="container-x pt-10 pb-16 md:pt-16 md:pb-24">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-reveal>
      <span class="label text-lime">{site.name}</span>
      <span class="h-px w-8 bg-line" aria-hidden="true"></span>
      <span class="label text-mute">{site.title}</span>
    </div>

    <h1 id="hero-title" class="display display-xl mt-6 md:mt-8" data-reveal style="--reveal-delay:80ms">
      <span class="block">Less manual work.</span>
      <span class="block">More systems</span>
      <span class="block">that <span class="relative inline-block text-ink"><span class="absolute inset-x-[-0.06em] inset-y-[0.06em] bg-lime" aria-hidden="true"></span><span class="relative">move.</span></span></span>
    </h1>

    <div class="mt-10 grid gap-12 md:mt-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6 xl:col-span-5" data-reveal style="--reveal-delay:160ms">
        <p class="lead max-w-xl text-paper/85">
          I connect AI, APIs and business software to automate repetitive work, improve operational follow through and
          turn incoming information into useful action.
        </p>
        <div class="mt-8 flex flex-col gap-3 xs:flex-row">
          <a href="#work" class="btn btn-lime">Explore selected work <Icon name="arrow-right" /></a>
          <a href="#contact" class="btn btn-ghost">Discuss a project</a>
        </div>
        <SystemFlow class="mt-12 max-w-md" />
      </div>

      <div class="relative lg:col-span-6 lg:col-start-7 xl:col-span-6 xl:col-start-7" data-reveal style="--reveal-delay:240ms">
        <div class="grid grid-cols-12 items-end gap-3">
          <Portrait eager class="col-span-12 aspect-[5/4] rounded-sm sm:col-span-7 sm:aspect-[4/5]" />
          <div class="col-span-12 grid grid-cols-2 gap-3 sm:col-span-5 sm:flex sm:flex-col">
            <div class="rounded-sm border border-line bg-ink-2 p-3 sm:p-4">
              <p class="label !text-[0.6rem] text-mute">Execution log</p>
              <ul class="mt-3 space-y-1.5 font-mono text-[0.62rem] sm:text-xs" aria-label="Example workflow run">
                {
                  log.map((line) => (
                    <li class="flex gap-2 overflow-hidden whitespace-nowrap">
                      <span class={line.tone} aria-hidden="true">{line.mark}</span>
                      <span class="truncate text-paper/80">{line.text}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="rounded-sm bg-orange p-3 text-ink sm:p-4">
              <p class="label !text-[0.6rem]">Credential</p>
              <p class="mt-2 font-display text-lg leading-none font-extrabold [font-stretch:70%] sm:text-2xl">
                n8n certified
              </p>
              <p class="mt-1 font-mono text-[0.6rem] sm:text-[0.68rem]">{site.certificate.issued}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
