---
const steps = [
  {
    title: 'Understand the process',
    body: 'Find the trigger, the current workflow, the people involved, the repetitive work, the business rules and where things usually break.',
    out: 'Process map',
  },
  {
    title: 'Design the system',
    body: 'Map the data flow, integrations and decision logic, and decide honestly where AI adds value and where plain rules are better.',
    out: 'System design',
  },
  {
    title: 'Build and validate',
    body: 'Implement the workflow and test the normal path and the exceptions: missing data, failed services, retries and human handoff.',
    out: 'Tested workflow',
  },
  {
    title: 'Improve and maintain',
    body: 'Monitor runs, surface errors clearly, refine the rules and adapt the system as the business and its tools change.',
    out: 'Reliable operation',
  },
];
---

<section id="approach" class="canvas-bg border-t border-line bg-ink" aria-labelledby="approach-title">
  <div class="container-x section-y">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-lime">How I approach automation</p>
      <h2 id="approach-title" class="display display-lg mt-4">Process first. Tools second.</h2>
      <p class="lead mt-6 text-paper/70">
        Automation that ignores how the work really happens just moves the mess somewhere faster. So every build starts with
        the process.
      </p>
    </div>

    <ol class="relative mt-14 grid gap-5 md:mt-20 md:grid-cols-2 xl:grid-cols-4 xl:gap-6">
      <li class="pointer-events-none absolute top-[3rem] right-10 left-10 hidden h-px bg-line xl:block" aria-hidden="true"></li>
      {
        steps.map((step, i) => (
          <li class="node flex flex-col p-6 sm:p-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  'relative z-10 flex h-10 w-10 items-center justify-center rounded-xl border font-mono text-sm font-semibold',
                  i === 0 ? 'border-orange bg-ink text-orange' : i === steps.length - 1 ? 'border-lime bg-lime text-ink' : 'border-line bg-ink text-paper',
                ]}
              >
                0{i + 1}
              </span>
              <span class="font-mono text-[0.7rem] text-mute">step_{i + 1}</span>
            </div>
            <h3 class="display mt-8 text-[1.45rem]">{step.title}</h3>
            <p class="mt-3 mb-6 leading-relaxed text-paper/70">{step.body}</p>
            <p class="mt-auto inline-flex items-center gap-2 self-start rounded-full border border-line px-3 py-1.5 font-mono text-[0.7rem] text-paper/85">
              <span class="h-1.5 w-1.5 rounded-full bg-lime" aria-hidden="true" />
              {step.out}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
