---
const steps = [
  {
    title: 'Understand the process',
    body: 'Find the trigger, the current workflow, the people involved, the repetitive work, the business rules and where things usually break.',
    out: 'Process map',
  },
  {
    title: 'Design the system',
    body: 'Map the data flow, integrations and decision logic, and decide honestly where AI adds value and where plain rules are better.',
    out: 'System design',
  },
  {
    title: 'Build and validate',
    body: 'Implement the workflow and test the normal path and the exceptions: missing data, failed services, retries and human handoff.',
    out: 'Tested workflow',
  },
  {
    title: 'Improve and maintain',
    body: 'Monitor runs, surface errors clearly, refine the rules and adapt the system as the business and its tools change.',
    out: 'Reliable operation',
  },
];
---

<section id="approach" class="on-light dot-bg bg-paper text-ink" aria-labelledby="approach-title">
  <div class="container-x section-y">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <div class="lg:sticky lg:top-28">
          <p class="label text-mute-dark">How I approach automation</p>
          <h2 id="approach-title" class="display display-lg mt-4">Process first. Tools second.</h2>
          <p class="mt-6 max-w-sm leading-relaxed text-mute-dark">
            Automation that ignores how the work really happens just moves the mess somewhere faster. So the build always
            starts with the process.
          </p>
        </div>
      </div>

      <ol class="lg:col-span-7 lg:col-start-6">
        {
          steps.map((step, i) => (
            <li
              class="grid grid-cols-[3.25rem_1fr] gap-x-4 border-t border-ink py-8 last:border-b sm:grid-cols-[5rem_1fr] sm:gap-x-6 sm:py-10"
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <span class="display text-[2.6rem] leading-none sm:text-[3.4rem]">0{i + 1}</span>
              <div>
                <h3 class="font-display text-2xl leading-tight font-bold [font-stretch:80%] sm:text-[1.75rem]">{step.title}</h3>
                <p class="mt-3 max-w-xl leading-relaxed text-mute-dark">{step.body}</p>
                <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-ink px-3 py-1.5 font-mono text-[0.7rem] text-paper">
                  <span class="h-1.5 w-1.5 rounded-full bg-lime" aria-hidden="true" />
                  Output: {step.out}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
