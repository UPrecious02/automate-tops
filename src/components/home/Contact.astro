---
import Icon from '../Icon.astro';
import { site, socialLinks } from '../../data/site';

interface Props {
  /** Use 'h1' when the contact section is the main content of the page. */
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const fields = [
  { id: 'name', label: 'Your name', type: 'text' as const, autocomplete: 'name', required: true },
  { id: 'email', label: 'Email address', type: 'email' as const, autocomplete: 'email', required: true },
  { id: 'context', label: 'Business or project', type: 'text' as const, autocomplete: 'organization', required: false },
];
---

<section id="contact" class:list={['canvas-bg bg-ink', headingLevel === 'h2' && 'border-t border-line']} aria-labelledby="contact-title">
  <div class="container-x section-y">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6" data-reveal>
        <p class="label text-lime">Contact</p>
        <Heading id="contact-title" class="display display-lg mt-4">Let's make the workflow work better.</Heading>
        <p class="lead mt-6 max-w-lg text-paper/75">
          Have a repetitive process, disconnected tools or an operational bottleneck worth solving? Let's discuss the system
          you need.
        </p>

        <ul class="mt-10 max-w-md space-y-3">
          <li>
            <a href={`mailto:${site.email}`} class="node group flex items-center justify-between gap-4 px-5 py-4 transition-colors hover:border-lime">
              <span class="flex items-center gap-3 font-semibold break-all"><Icon name="mail" />{site.email}</span>
              <Icon name="arrow-up-right" class="shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </li>
          {
            socialLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="node group flex items-center justify-between gap-4 px-5 py-4 transition-colors hover:border-lime">
                  <span class="font-semibold">{link.label}</span>
                  <span class="sr-only">(opens in a new tab)</span>
                  <Icon name="arrow-up-right" class="shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-6" data-reveal style="--reveal-delay:100ms">
        <form
          id="enquiry-form"
          name="project-enquiry"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="company-website"
          class="node p-6 text-paper sm:p-10" style="--port:#C5F467"
          novalidate
        >
          <span class="port-l hidden lg:block" aria-hidden="true"></span>
          <input type="hidden" name="form-name" value="project-enquiry" />
          <p class="hidden" aria-hidden="true">
            <label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="flex items-center justify-between">
            <p class="label text-lime">Project enquiry</p>
            <p class="font-mono text-[0.7rem] text-mute">* required</p>
          </div>

          <div class="mt-8 grid gap-5">
            {
              fields.map((field) => (
                <div>
                  <label for={field.id} class="label block text-paper/80">
                    {field.label}
                    {field.required && <span class="text-lime"> *</span>}
                  </label>
                  <input
                    id={field.id}
                    name={field.id}
                    type={field.type}
                    autocomplete={field.autocomplete}
                    required={field.required}
                    aria-describedby={`${field.id}-error`}
                    class="mt-2 block w-full rounded-xl border border-line bg-ink px-4 py-3 text-base text-paper transition-colors focus:border-lime focus:outline-none aria-[invalid=true]:border-orange"
                  />
                  <p id={`${field.id}-error`} class="mt-2 hidden items-center gap-1.5 text-sm text-orange" data-error></p>
                </div>
              ))
            }

            <div>
              <label for="message" class="label block text-paper/80">
                What would you like to automate?<span class="text-lime"> *</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                minlength="10"
                aria-describedby="message-error"
                class="mt-2 block w-full resize-y rounded-xl border border-line bg-ink px-4 py-3 text-base text-paper transition-colors focus:border-lime focus:outline-none aria-[invalid=true]:border-orange"
              ></textarea>
              <p id="message-error" class="mt-2 hidden text-sm text-orange" data-error></p>
            </div>
          </div>

          <button type="submit" class="btn btn-lime mt-8 w-full disabled:cursor-wait disabled:opacity-70" data-submit>
            <span data-submit-label>Send enquiry</span>
            <Icon name="arrow-right" />
          </button>

          <div id="form-status" class="mt-5 hidden rounded-xl p-4 text-sm leading-relaxed" role="status" aria-live="polite" tabindex="-1"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;

  if (form) {
    const status = document.getElementById('form-status');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');

    const messages: Record<string, (el: HTMLInputElement | HTMLTextAreaElement) => string> = {
      name: (el) => (el.value.trim() ? '' : 'Please enter your name.'),
      email: (el) => {
        const value = el.value.trim();
        if (!value) return 'Please enter your email address.';
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) ? '' : 'Please enter a valid email address.';
      },
      message: (el) => {
        const value = el.value.trim();
        if (!value) return 'Please tell me a little about the process.';
        return value.length >= 10 ? '' : 'Please add a few more details.';
      },
    };

    const showError = (el: HTMLInputElement | HTMLTextAreaElement, text: string) => {
      const error = document.getElementById(`${el.id}-error`);
      el.setAttribute('aria-invalid', text ? 'true' : 'false');
      if (!error) return;
      error.textContent = text;
      error.classList.toggle('hidden', !text);
      error.classList.toggle('flex', Boolean(text));
    };

    const validate = (): HTMLInputElement | HTMLTextAreaElement | null => {
      let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
      for (const name of Object.keys(messages)) {
        const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
        if (!el) continue;
        const text = messages[name](el);
        showError(el, text);
        if (text && !firstInvalid) firstInvalid = el;
      }
      return firstInvalid;
    };

    Object.keys(messages).forEach((name) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
      if (!el) return;
      el.addEventListener('blur', () => {
        if (el.value.trim()) showError(el, messages[name](el));
      });
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') showError(el, messages[name](el));
      });
    });

    const setStatus = (type: 'success' | 'error', text: string) => {
      if (!status) return;
      status.textContent = text;
      status.classList.remove('hidden', 'bg-lime', 'text-ink', 'border', 'border-orange', 'text-orange');
      if (type === 'success') status.classList.add('bg-lime', 'text-ink');
      else status.classList.add('border', 'border-orange', 'text-orange');
      status.focus();
    };

    const setLoading = (loading: boolean) => {
      if (!submit || !submitLabel) return;
      submit.disabled = loading;
      submitLabel.textContent = loading ? 'Sending…' : 'Send enquiry';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status?.classList.add('hidden');

      const firstInvalid = validate();
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      setLoading(true);
      try {
        const body = new URLSearchParams();
        new FormData(form).forEach((value, key) => {
          if (typeof value === 'string') body.append(key, value);
        });

        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });

        if (!response.ok) throw new Error(`Request failed with status ${response.status}`);

        form.reset();
        form.querySelectorAll('[aria-invalid]').forEach((el) => el.setAttribute('aria-invalid', 'false'));
        setStatus('success', 'Thanks, your enquiry has been sent. You will get a reply by email soon.');
      } catch {
        setStatus('error', 'Your enquiry could not be sent. Please try again, or email me directly at the address on this page.');
      } finally {
        setLoading(false);
      }
    });
  }
</script>
