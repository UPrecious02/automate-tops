---
// Only list technologies John can confidently discuss and demonstrate.
const groups = [
  { title: 'Workflow automation', kind: 'Platforms', items: ['n8n', 'Make', 'Zapier'] },
  { title: 'AI & language models', kind: 'Services', items: ['OpenAI API', 'Anthropic API', 'Embeddings'] },
  { title: 'Integrations', kind: 'Capabilities', items: ['REST APIs', 'Webhooks', 'HTTP requests', 'JSON'] },
  { title: 'Data & storage', kind: 'Platforms', items: ['Supabase', 'Vector stores', 'SQL', 'Google Sheets'] },
  { title: 'Messaging channels', kind: 'Platforms', items: ['WhatsApp', 'Twilio SMS', 'Telegram', 'Gmail'] },
  { title: 'Business applications', kind: 'Platforms', items: ['Google Workspace', 'Airtable', 'HubSpot', 'Slack'] },
  { title: 'Programming', kind: 'Languages', items: ['JavaScript', 'Python', 'HTML', 'CSS'] },
  { title: 'Development tools', kind: 'Tools', items: ['Git', 'GitHub', 'VS Code'] },
];

// Grid placement around the central hub on large screens (3 × 3, hub in the middle).
const before = groups.slice(0, 4);
const after = groups.slice(4);
---

<section id="stack" class="on-light canvas-bg-light relative overflow-hidden bg-paper text-ink" aria-labelledby="stack-title">
  <div class="container-x section-y">
    <div class="max-w-5xl" data-reveal>
      <p class="label text-mute-dark">Tools and technical capabilities</p>
      <h2 id="stack-title" class="display display-lg mt-4">One workflow at the centre. Everything else connects.</h2>
    </div>

    <div class="relative mt-14 md:mt-20">
      <div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
        <span class="absolute top-1/2 right-[8%] left-[8%] h-px bg-ink/20"></span>
        <span class="absolute top-[8%] bottom-[8%] left-1/2 w-px bg-ink/20"></span>
      </div>

      <ul class="relative grid gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
        {
          before.map((group, i) => (
            <li class="node p-6 text-paper" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <div class="flex items-center justify-between gap-3">
                <h3 class="display text-lg">{group.title}</h3>
                <span class="label !text-[0.6rem] text-mute">{group.kind}</span>
              </div>
              <ul class="mt-5 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="chip text-paper/80">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }

        <li class="order-first flex flex-col justify-between rounded-[1.25rem] bg-lime p-6 text-ink sm:col-span-2 lg:order-none lg:col-span-1" data-reveal>
          <div class="flex items-center justify-between">
            <span class="label">Hub</span>
            <span class="flex gap-1" aria-hidden="true">
              <span class="h-2 w-2 rounded-full bg-ink"></span>
              <span class="h-2 w-2 rounded-full bg-ink/40"></span>
              <span class="h-2 w-2 rounded-full bg-ink/20"></span>
            </span>
          </div>
          <p class="display mt-8 text-[2.4rem] lg:text-[2.6rem]">The workflow</p>
          <p class="mt-3 text-sm leading-relaxed">
            Triggers, logic and error handling live here. AI models, data and business apps plug in around it.
          </p>
        </li>

        {
          after.map((group, i) => (
            <li class="node p-6 text-paper" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <div class="flex items-center justify-between gap-3">
                <h3 class="display text-lg">{group.title}</h3>
                <span class="label !text-[0.6rem] text-mute">{group.kind}</span>
              </div>
              <ul class="mt-5 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="chip text-paper/80">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
