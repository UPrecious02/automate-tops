---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';

const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="on-light canvas-bg-light bg-paper text-ink" aria-labelledby="work-title">
  <div class="container-x section-y">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div data-reveal>
        <p class="label text-mute-dark">Selected work</p>
        <h2 id="work-title" class="display display-lg mt-4 max-w-3xl">Real workflows, built and running.</h2>
      </div>
      <p class="max-w-sm leading-relaxed text-mute-dark md:text-right" data-reveal style="--reveal-delay:100ms">
        Every project opens a full case study with the problem, the architecture, screenshots from real runs and what
        John would improve next.
      </p>
    </div>

    <ul class="mt-14 space-y-6 md:mt-20 md:space-y-8">
      {
        studies.map((study, i) => {
          const { data } = study;
          const cover = data.evidence[0];
          const flip = i % 2 === 1;
          return (
            <li data-reveal>
              <article class="group relative grid overflow-hidden rounded-[1.75rem] border border-ink/10 bg-paper-2/70 p-3 transition-colors duration-300 hover:border-ink/30 sm:p-4 lg:grid-cols-12 lg:gap-4">
                <div class:list={['min-w-0 lg:col-span-7', flip && 'lg:order-2']}>
                  <div class="frame !border-ink/10">
                    <div class="frame-bar">
                      <span class="frame-dots" aria-hidden="true">
                        <span />
                        <span />
                        <span />
                      </span>
                      <span class="min-w-0 truncate font-mono text-[0.7rem] text-mute">{data.workflowName}</span>
                    </div>
                    {cover ? (
                      <div class="aspect-[2/1] overflow-hidden bg-ink">
                        <img
                          src={cover.src}
                          alt={cover.alt}
                          width={cover.width}
                          height={cover.height}
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
                        />
                      </div>
                    ) : (
                      <div class="canvas-bg aspect-[2/1] bg-ink" />
                    )}
                  </div>
                </div>

                <div class:list={['flex min-w-0 flex-col p-4 pt-6 sm:p-6 lg:col-span-5 lg:p-8', flip && 'lg:order-1']}>
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="font-mono text-xs text-mute-dark">0{data.order}</span>
                    <span class:list={['h-2 w-2 rounded-full', data.accent === 'lime' ? 'bg-lime-dim' : 'bg-orange']} aria-hidden="true" />
                    <span class="label text-mute-dark">{data.category}</span>
                  </div>
                  <h3 class="display mt-4 text-[1.75rem] sm:text-[2.2rem]">
                    <a href={`/case-studies/${study.id}`} class="after:absolute after:inset-0 after:rounded-[1.75rem] focus-visible:outline-none">
                      {data.title}
                    </a>
                  </h3>
                  <p class="mt-4 leading-relaxed text-ink/75">{data.summary}</p>
                  <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tools">
                    {data.tools.slice(0, 4).map((tool) => (
                      <li class="chip text-ink/65">{tool}</li>
                    ))}
                  </ul>
                  <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold lg:mt-auto lg:pt-8" aria-hidden="true">
                    Read case study
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ink text-paper transition-colors duration-300 group-hover:bg-lime group-hover:text-ink">
                      <Icon name="arrow-up-right" size={16} />
                    </span>
                  </span>
                </div>
                <span class="pointer-events-none absolute inset-0 rounded-[1.75rem] ring-ink group-has-[a:focus-visible]:ring-2" aria-hidden="true" />
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
