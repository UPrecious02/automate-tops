---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';

// The first three case studies by `order` appear on the homepage.
const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const featured = studies.slice(0, 3);
---

<section class="on-light canvas-bg-light bg-paper text-ink" aria-labelledby="featured-title">
  <div class="container-x section-y">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <p class="label text-mute-dark">Selected work</p>
        <h2 id="featured-title" class="display display-lg mt-4">Real workflows, built and running.</h2>
      </div>
      <a href="/work" class="btn btn-ink shrink-0 self-start sm:self-auto">
        All {studies.length} case studies <Icon name="arrow-right" />
      </a>
    </div>

    <ul class="mt-12 grid gap-5 md:mt-16 md:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((study, i) => {
          const { data } = study;
          const cover = data.evidence[0];
          return (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <article class="group relative flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-ink/10 bg-paper-2/70 p-3 transition-colors duration-300 hover:border-ink/30">
                <div class="aspect-[16/10] overflow-hidden rounded-[1rem] bg-ink">
                  {cover && (
                    <img
                      src={cover.src}
                      alt={cover.alt}
                      width={cover.width}
                      height={cover.height}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  )}
                </div>
                <div class="flex flex-1 flex-col p-3 pt-5 sm:p-4 sm:pt-5">
                  <p class="flex items-center gap-2.5">
                    <span class:list={['h-2 w-2 rounded-full', data.accent === 'lime' ? 'bg-lime-dim' : 'bg-orange']} aria-hidden="true" />
                    <span class="label text-mute-dark">{data.category}</span>
                  </p>
                  <h3 class="display mt-3 text-[1.45rem]">
                    <a href={`/case-studies/${study.id}`} class="after:absolute after:inset-0 after:rounded-[1.5rem] focus-visible:outline-none">
                      {data.title}
                    </a>
                  </h3>
                  <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/70">{data.summary}</p>
                  <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold md:mt-auto md:pt-6" aria-hidden="true">
                    Read case study
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-paper transition-colors duration-300 group-hover:bg-lime group-hover:text-ink">
                      <Icon name="arrow-up-right" size={14} />
                    </span>
                  </span>
                </div>
                <span class="pointer-events-none absolute inset-0 rounded-[1.5rem] ring-ink group-has-[a:focus-visible]:ring-2" aria-hidden="true" />
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
