---
import { site } from '../data/site';

/**
 * Shows John's portrait once `site.portrait` is set in src/data/site.ts.
 * Until then it renders a branded monogram panel, so the layout never breaks.
 */
interface Props {
  class?: string;
  eager?: boolean;
}
const { class: className, eager = false } = Astro.props;
---

<div class:list={['relative overflow-hidden', className]}>
  {
    site.portrait ? (
      <img
        src={site.portrait}
        alt="Portrait of John Eyitope"
        width="800"
        height="1000"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        class="h-full w-full object-cover object-top"
      />
    ) : (
      <div class="canvas-bg-light flex h-full w-full items-center justify-center bg-paper" role="img" aria-label="John Eyitope monogram">
        <svg viewBox="0 0 48 48" class="w-[52%]" fill="none" aria-hidden="true">
          <path
            d="M8 9H40M20 9V30.5C20 35.2 16.2 39 11.5 39H8M28 9V39H40M28 24H35"
            stroke="#101010"
            stroke-width="4.5"
            stroke-linecap="square"
          />
          <circle cx="7" cy="9" r="5" fill="#C5F467" />
          <circle cx="7" cy="9" r="2.2" fill="#101010" />
          <circle cx="38" cy="24" r="3.5" fill="#FF784F" />
        </svg>
      </div>
    )
  }
</div>
