---
/** Screenshots from real workflow runs, listed under `evidence` in each case study file. */
interface Props {
  items: { src: string; alt: string; caption: string; width: number; height: number }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class:list={['grid gap-5', items.length > 1 && 'md:grid-cols-2']}>
      {items.map((item) => {
        const tall = item.height > item.width;
        const wide = item.width / item.height >= 1.6;
        return (
          <li class:list={[wide && items.length > 1 && 'md:col-span-2']}>
            <figure class="frame h-full">
              <a href={item.src} target="_blank" rel="noopener" class="flex justify-center bg-ink">
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  class:list={['w-full', tall && 'max-h-[34rem] w-auto object-contain']}
                />
                <span class="sr-only">Open full size image in a new tab</span>
              </a>
              <figcaption class="border-t border-line px-5 py-4 text-sm leading-relaxed text-paper/75">{item.caption}</figcaption>
            </figure>
          </li>
        );
      })}
    </ul>
  )
}
