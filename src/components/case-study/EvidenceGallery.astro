---
/** Renders real workflow screenshots once they are added to a case study's `evidence` list. */
interface Props {
  items: { src: string; alt: string; caption: string; width: number; height: number }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="grid gap-6 md:grid-cols-2">
      {items.map((item, i) => (
        <li class:list={[i === 0 && 'md:col-span-2']}>
          <figure class="overflow-hidden rounded-sm border border-line bg-ink-2">
            <a href={item.src} target="_blank" rel="noopener" class="block">
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
                class="w-full"
              />
              <span class="sr-only">Open full size image in a new tab</span>
            </a>
            <figcaption class="border-t border-line px-5 py-4 text-sm leading-relaxed text-paper/75">
              <span class="label mr-2 text-lime">Fig. {String(i + 1).padStart(2, '0')}</span>
              {item.caption}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )
}
